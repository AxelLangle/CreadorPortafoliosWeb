# ============================================================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN (VERCEL / LOCAL)
# Copia este archivo como .env o configura estas variables en el panel de Vercel
# ============================================================================

# 1. Credenciales Exclusivas del Super Administrador (/admin)
VITE_ADMIN_EMAIL=admin@linkportfolio.app
VITE_ADMIN_PASSWORD=AdminLinkPortfolio2026!

# 2. Credenciales Propietarias del Portafolio Protegido Principal
VITE_ARAAABY_OWNER_EMAIL=propietario@portafolio.app
VITE_ARAAABY_OWNER_PASSWORD=TuPasswordSeguro2026!

# 3. Client ID de Google OAuth 2.0 (Google Identity Services)
# Obtenlo en: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
